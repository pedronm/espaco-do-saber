{
  "name": "fe-espaco-do-saber",
  "compatibility_date": "2026-03-07",

  "assets": {
    "directory": "dist/cloudflare/browser",
    // Enable SPA routing: serve index.html for routes not found (e.g., /dashboard, /settings/profile)
    // This allows Angular client-side router to handle navigation
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }

}