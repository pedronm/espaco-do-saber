{
  "name": "espaco-do-saber-frontend",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod:cloudflare": "ng build --configuration production --output-path=dist/cloudflare/browser",
    "deploy:paviment:cloudflare": "npx wrangler deploy dist/cloudflare/browser --name=fe-espaco-do-saber",
    "deploy:with-build:cloudflare": "npm run build:prod:cloudflare && npx wrangler deploy",
    "deploy": "npx wrangler deploy",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.18",
    "@angular/common": "^19.2.18",
    "@angular/compiler": "^19.2.18",
    "@angular/core": "^19.2.18",
    "@angular/forms": "^19.2.18",
    "@angular/platform-browser": "^19.2.18",
    "@angular/platform-browser-dynamic": "^19.2.18",
    "@angular/router": "^19.2.18",
    "@stomp/stompjs": "^7.0.0",
    "flv.js": "^1.6.2",
    "hls.js": "1.5.17",
    "ngx-webcam": "^0.4.1",
    "@supabase/supabase-js": "^2.49.1",
    "rxjs": "~7.8.0",
    "sockjs-client": "^1.6.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.18",
    "@types/node": "^22.13.10",
    "@types/jasmine": "~5.1.0",
    "@types/sockjs-client": "^1.5.4",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.6.0"
  },
  "buildOptions": {
    "assets": [
      "src/favicon.ico",
      "src/assets"
    ]
  }
}
