{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "espaco-do-saber-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-05",
  "vars": {
    "APP_ENV": "production",
    "AUTH0_AUDIENCE": "https://api.espacodosaber.com"
  },
  "r2_buckets": [
    {
      "binding": "VIDEOS_BUCKET",
      "bucket_name": "espaco-do-saber-videos"
    }
  ]
}
